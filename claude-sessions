def this_executable():
    """Absolute path of this command, as hooks should invoke it."""
    argv0 = sys.argv[0] if sys.argv else ""
    if argv0 and os.path.sep in argv0:
        return os.path.abspath(argv0)
    import shutil
    return shutil.which("claude-sessions") or os.path.abspath(argv0 or __file__)


def is_our_hook(h):
    return h.get("type") == "command" and str(h.get("command", "")).endswith(HOOK_SUFFIX)


def load_settings():
    if os.path.exists(CLAUDE_SETTINGS) and os.path.getsize(CLAUDE_SETTINGS) > 0:
        with open(CLAUDE_SETTINGS) as fh:
            return json.load(fh)
    return {}


def save_settings(settings, backup=True):
    import shutil
    os.makedirs(os.path.dirname(CLAUDE_SETTINGS), exist_ok=True)
    if backup and os.path.exists(CLAUDE_SETTINGS):
        stamp = time.strftime("%Y%m%d-%H%M%S")
        shutil.copy2(CLAUDE_SETTINGS, f"{CLAUDE_SETTINGS}.bak.{stamp}")
    tmp = CLAUDE_SETTINGS + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(settings, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, CLAUDE_SETTINGS)


def hooks_status(settings, cmd):
    """(events pointing at cmd, events pointing at another/missing claude-sessions)."""
    ours, stale = [], []
    for event in HOOK_EVENTS:
        for g in settings.get("hooks", {}).get(event, []):
            for h in g.get("hooks", []):
                if is_our_hook(h):
                    (ours if h["command"] == cmd else stale).append(event)
    return ours, stale


def cmd_setup(quiet=False):
    """Merge our hooks into settings.json (keeps everything else, backs up)."""
    cmd = f"{this_executable()} hook"
    settings = load_settings()
    hooks = settings.setdefault("hooks", {})
    changed = []
    for event, timeout in HOOK_EVENTS.items():
        groups = hooks.setdefault(event, [])
        present = False
        for g in groups:
            for h in g.get("hooks", []):
                if is_our_hook(h):
                    if h["command"] != cmd:  # moved install: repoint it
                        h["command"] = cmd
                        changed.append(event)
                    present = True
        if not present:
            groups.append({"hooks": [{"type": "command", "command": cmd, "timeout": timeout}]})
            changed.append(event)
    if changed:
        save_settings(settings)
    if not quiet:
        print(f"Hook command: {cmd}")
        print("Hooks registered:", ", ".join(sorted(set(changed))) if changed else "none (already up to date)")
    return 0


def cmd_unsetup():
    """Remove only the hooks whose command ends in 'claude-sessions hook'."""
    settings = load_settings()
    hooks = settings.get("hooks") or {}
    removed = 0
    for event in list(hooks):
        groups = []
        for g in hooks[event]:
            kept = [h for h in g.get("hooks", []) if not is_our_hook(h)]
            removed += len(g.get("hooks", [])) - len(kept)
            if kept:
                g["hooks"] = kept
                groups.append(g)
        if groups:
            hooks[event] = groups
        else:
            del hooks[event]
    if not hooks:
        settings.pop("hooks", None)
    if removed:
        save_settings(settings)
    print(f"Hooks removed: {removed}")
    return 0


def ensure_hooks():
    """Register hooks silently if missing or pointing elsewhere (indicator start)."""
    try:
        ours, stale = hooks_status(load_settings(), f"{this_executable()} hook")
        if len(set(ours)) < len(HOOK_EVENTS) or stale:
            cmd_setup(quiet=True)
    except Exception as exc:  # noqa: BLE001
        print(f"Could not register hooks: {exc}", file=sys.stderr)


