def truncate(text, limit):
    text = " ".join(str(text or "").split())
    if len(text) <= limit:
        return text
    return text[: limit - 1].rstrip() + "…"


def message_summary(text):
    """First meaningful line of an assistant message, markdown stripped.

    Skips fenced code blocks, tables and rules; uses a heading only when the
    message has no body line.
    """
    heading = ""
    in_code = False
    for line in str(text or "").splitlines():
        stripped = line.strip()
        if stripped.startswith("```"):
            in_code = not in_code
            continue
        if in_code or not stripped or stripped.startswith(("|", "---", "***")):
            continue
        is_heading = stripped.startswith("#")
        clean = stripped.lstrip("#>-*• ").replace("**", "").replace("`", "").strip()
        if not clean:
            continue
        if is_heading:
            heading = heading or clean
            continue
        return clean
    return heading


def pid_alive(pid):
    """True if the PID exists and is still a `claude` process."""
    if not pid:
        return False
    try:
        with open(f"/proc/{pid}/comm") as fh:
            return fh.read().strip() == "claude"
    except OSError:
        return False


def indicator_pid():
    """PID of the running indicator according to the pidfile, or None."""
    try:
        with open(PID_FILE) as fh:
            pid = int(fh.read().strip())
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            argv = fh.read().split(b"\0")
        if b"indicator" in argv and any(a.endswith(b"claude-sessions") for a in argv):
            return pid
    except (OSError, ValueError):
        pass
    return None


def read_json(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def write_json_atomic(path, data):
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh, ensure_ascii=False)
    os.replace(tmp, path)


def list_sessions():
    """Return [(path, data)] for every valid state file, plus live sessions
    known to Claude Code's registry that have produced no hook event yet
    (path None), so a fresh install shows existing sessions immediately."""
    out = []
    seen = set()
    try:
        names = os.listdir(STATE_DIR)
    except OSError:
        names = []
    for name in names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(STATE_DIR, name)
        data = read_json(path)
        if isinstance(data, dict) and data.get("session_id"):
            out.append((path, data))
            seen.add(data["session_id"])
    for data in registry_sessions():
        if data["session_id"] not in seen:
            out.append((None, data))
    return out


# Claude Code's registry status -> our state (only until the first hook event)
REGISTRY_STATE = {"busy": "running", "shell": "running"}


def registry_sessions():
    """Live interactive sessions from ~/.claude/sessions/<pid>.json (internal,
    undocumented registry present in Claude Code 2.1.x)."""
    out = []
    try:
        names = os.listdir(CLAUDE_SESSIONS_DIR)
    except OSError:
        return out
    for name in names:
        if not name.endswith(".json") or "." in name[:-5]:
            continue
        data = read_json(os.path.join(CLAUDE_SESSIONS_DIR, name))
        if not data or not data.get("sessionId") or not pid_alive(data.get("pid")):
            continue
        cwd = data.get("cwd") or ""
        state = REGISTRY_STATE.get(data.get("status"), "idle")
        out.append({
            "session_id": data["sessionId"],
            "state": state,
            "summary": DEFAULT_SUMMARY["running"] if state == "running" else "no hook events yet",
            "cwd": cwd,
            "name": derive_name(cwd, ""),
            "session_title": "",
            "transcript_path": "",
            "pid": data.get("pid"),
            "started_at": (data.get("startedAt") or 0) / 1000.0 or None,
            "event": "",
            "updated_at": (data.get("updatedAt") or 0) / 1000.0 or time.time(),
        })
    return out


def remove_dead(sessions):
    """Delete files whose PID is gone. Return the live sessions."""
    alive = []
    for path, data in sessions:
        if pid_alive(data.get("pid")):
            alive.append((path, data))
        elif path:
            try:
                os.unlink(path)
            except OSError:
                pass
    return alive


def sort_key(data):
    """Stable order by session start time (oldest first)."""
    return (data.get("started_at") or data.get("updated_at") or 0, data.get("session_id") or "")


