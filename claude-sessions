def icon_name(state):
    """Bar icon name for a state ('none' = plain Claude glyph)."""
    return f"claude-sessions-{state or 'none'}"


def render_icons(size=64):
    """Render one PNG per state into ICON_DIR: Claude glyph plus colour badge.

    The plain glyph is the bar icon; the badged ones are used for desktop
    notifications. Returns ICON_DIR, or None when cairo/rsvg are unavailable
    (the indicator then falls back to a theme icon).
    """
    try:
        import cairo
        import gi
        gi.require_version("Rsvg", "2.0")
        from gi.repository import Rsvg
    except (ImportError, ValueError):
        return None
    os.makedirs(ICON_DIR, exist_ok=True)
    r, g, b = CLAUDE_ORANGE
    svg = (
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">'
        f'<path fill="rgb({int(r*255)},{int(g*255)},{int(b*255)})" d="{CLAUDE_PATH}"/>'
        "</svg>"
    ).encode()
    handle = Rsvg.Handle.new_from_data(svg)
    for state in list(STATES) + [None]:
        path = os.path.join(ICON_DIR, icon_name(state) + ".png")
        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
        cr = cairo.Context(surface)
        # Glyph fills ~86% of the canvas, bottom-left, leaving room for a badge
        glyph = size * 0.86
        rect = Rsvg.Rectangle()
        rect.x, rect.y, rect.width, rect.height = 0, size - glyph, glyph, glyph
        handle.render_document(cr, rect)
        if state:
            br, bg, bb = BADGE_COLOR[state]
            radius = size * 0.20
            cx, cy = size - radius - 1, radius + 1
            # Dark outline so the badge separates from the glyph on any background
            cr.set_source_rgba(0.12, 0.12, 0.12, 0.9)
            cr.arc(cx, cy, radius + size * 0.03, 0, 6.2832)
            cr.fill()
            cr.set_source_rgb(br, bg, bb)
            cr.arc(cx, cy, radius, 0, 6.2832)
            cr.fill()
            if state == "waiting":  # white question mark
                cr.set_source_rgb(1, 1, 1)
                cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
                cr.set_font_size(radius * 1.6)
                ext = cr.text_extents("?")
                cr.move_to(cx - ext.width / 2 - ext.x_bearing, cy + ext.height / 2)
                cr.show_text("?")
        surface.flush()
        surface.write_to_png(path)
    return ICON_DIR


