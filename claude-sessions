_TITLE_CACHE = {}  # path -> (mtime, size, title)


def transcript_title(path):
    """Session title from its transcript (Claude Code internal format).

    Looks for the last `custom-title` line (/rename) and, failing that, the
    last `ai-title` line (the generated title shown in the terminal). Reads
    only the tail of the file; if nothing is there, the whole file. Returns
    '' when there is no title.
    """
    import re
    try:
        st = os.stat(path)
    except OSError:
        return ""
    cached = _TITLE_CACHE.get(path)
    if cached and cached[0] == st.st_mtime and cached[1] == st.st_size:
        return cached[2]

    def find(data):
        for key in ("customTitle", "aiTitle"):
            hits = re.findall(rb'"' + key.encode() + rb'":"((?:[^"\\]|\\.)*)"', data)
            if hits:
                try:
                    return json.loads('"' + hits[-1].decode("utf-8", "replace") + '"')
                except ValueError:
                    continue
        return ""

    title = ""
    try:
        with open(path, "rb") as fh:
            tail = 262144
            if st.st_size > tail:
                fh.seek(st.st_size - tail)
            title = find(fh.read())
            if not title and st.st_size > tail:
                fh.seek(0)
                title = find(fh.read())
    except OSError:
        pass
    _TITLE_CACHE[path] = (st.st_mtime, st.st_size, title)
    return title


def find_transcript(session_id):
    """Locate the transcript under ~/.claude/projects (older state files)."""
    try:
        for proj in os.listdir(CLAUDE_PROJECTS_DIR):
            cand = os.path.join(CLAUDE_PROJECTS_DIR, proj, f"{session_id}.jsonl")
            if os.path.isfile(cand):
                return cand
    except OSError:
        pass
    return ""


def display_name(d):
    """Name to show: /rename > title generated by Claude Code > cwd@branch."""
    if d.get("session_title"):
        return truncate(d["session_title"], NAME_MAX)
    path = d.get("transcript_path") or find_transcript(d.get("session_id") or "")
    title = transcript_title(path) if path else ""
    return truncate(title, NAME_MAX) if title else (d.get("name") or "?")


def registry_start_times():
    """{sessionId: started_at} from Claude Code's internal registry."""
    out = {}
    try:
        for name in os.listdir(CLAUDE_SESSIONS_DIR):
            if name.endswith(".json") and "." not in name[:-5]:
                data = read_json(os.path.join(CLAUDE_SESSIONS_DIR, name))
                if data and data.get("sessionId") and data.get("startedAt"):
                    out[data["sessionId"]] = data["startedAt"] / 1000.0
    except OSError:
        pass
    return out


def disambiguate(sessions):
    """Add ·1, ·2 suffixes to duplicate names. Return a sorted list of dicts."""
    # State files written before started_at existed: fill from the registry
    if any(not d.get("started_at") for _, d in sessions):
        starts = registry_start_times()
        for _, d in sessions:
            if not d.get("started_at"):
                d["started_at"] = starts.get(d.get("session_id")) or d.get("updated_at")
    by_name = {}
    for _, data in sessions:
        by_name.setdefault(display_name(data), []).append(data)
    out = []
    for name, group in by_name.items():
        group.sort(key=sort_key)
        for i, data in enumerate(group):
            d = dict(data)
            d["label"] = name if len(group) == 1 else f"{name}·{i + 1}"
            out.append(d)
    out.sort(key=sort_key)
    return out


def cmd_status():
    sessions = disambiguate(remove_dead(list_sessions()))
    if not sessions:
        print("No Claude Code sessions registered.")
        return
    for d in sessions:
        age = int(time.time() - (d.get("updated_at") or time.time()))
        print(f"{TAG[d['state']]} [{d['label']}] {d.get('summary') or ''}  "
              f"(pid {d.get('pid')}, {age}s ago, {d.get('cwd')})")


def cmd_clean():
    before = list_sessions()
    alive = remove_dead(before)
    print(f"Removed {len(before) - len(alive)} dead sessions, {len(alive)} alive.")


