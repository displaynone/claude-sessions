def cmd_indicator():
    import gi
    import subprocess
    import warnings

    warnings.filterwarnings("ignore", category=DeprecationWarning)  # ImageMenuItem in GTK3

    gi.require_version("Gtk", "3.0")
    gi.require_version("AyatanaAppIndicator3", "0.1")
    from gi.repository import AyatanaAppIndicator3 as AppIndicator
    from gi.repository import Gio, GLib, Gtk

    POLL_SECONDS = 5
    # Maximum number of session icons in the bar. The GNOME extension inserts
    # every new icon at the left and cannot reorder or drop items while the
    # process lives, so all slots are created at startup (in reverse order)
    # and the sorted sessions are assigned to slots 1..N. Slot 0 is Claude.
    SLOTS = int(os.environ.get("CLAUDE_SESSIONS_SLOTS") or 12)
    os.makedirs(STATE_DIR, exist_ok=True)

    # Single instance (autostart and install.sh may race)
    other = indicator_pid()
    if other and other != os.getpid():
        print(f"An indicator is already running (pid {other})", file=sys.stderr)
        return 0
    with open(PID_FILE, "w") as fh:
        fh.write(str(os.getpid()))
    if os.environ.get("CLAUDE_SESSIONS_NO_SETUP") != "1":
        ensure_hooks()

    def icon_item(text, icon):
        item = Gtk.ImageMenuItem(label=text)
        if icon:
            item.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU))
            item.set_always_show_image(True)
        return item

    class Slot:
        """A fixed AppIndicator in the bar: Claude (slot 0) or one session."""

        def __init__(self, index, app):
            self.index = index
            self.app = app
            self.session_id = None
            self.icon = None
            ident = f"claude-sessions-{index:02d}"
            if index == 0 and app.icon_dir:
                self.ind = AppIndicator.Indicator.new_with_path(
                    ident, icon_name(None),
                    AppIndicator.IndicatorCategory.APPLICATION_STATUS, app.icon_dir)
            else:
                self.ind = AppIndicator.Indicator.new(
                    ident, "utilities-terminal-symbolic" if index == 0 else STATE_ICON["idle"],
                    AppIndicator.IndicatorCategory.APPLICATION_STATUS)
            self.ind.set_title("Claude Code")
            self.ind.set_label("", "")
            self.menu = Gtk.Menu()
            self.ind.set_menu(self.menu)
            self.ind.set_status(AppIndicator.IndicatorStatus.PASSIVE)

        def hide(self):
            self.session_id = None
            self.ind.set_status(AppIndicator.IndicatorStatus.PASSIVE)

        def set_icon(self, icon, desc):
            if icon != self.icon:
                self.icon = icon
                self.ind.set_icon_full(icon, desc)

        def clear_menu(self):
            for child in self.menu.get_children():
                self.menu.remove(child)

        def show_claude(self, sessions):
            """Slot 0: Claude glyph with the global menu."""
            self.clear_menu()
            if not sessions:
                item = Gtk.MenuItem(label="No Claude Code sessions")
                item.set_sensitive(False)
                self.menu.append(item)
            for d in sessions:
                item = icon_item(f"[{d['label']}] {d.get('summary') or ''}", STATE_ICON[d["state"]])
                item.set_tooltip_text(d.get("cwd") or "")
                item.connect("activate", self.app.copy_cwd, d)
                self.menu.append(item)
            self.menu.append(Gtk.SeparatorMenuItem())
            item = icon_item("Clean up dead sessions", "edit-clear-all-symbolic")
            item.connect("activate", lambda *_: self.app.refresh())
            self.menu.append(item)
            item = icon_item("Quit", "application-exit-symbolic")
            item.connect("activate", lambda *_: Gtk.main_quit())
            self.menu.append(item)
            self.menu.show_all()
            self.ind.set_status(AppIndicator.IndicatorStatus.ACTIVE)

        def show_session(self, d):
            """Slots 1..N: state icon of one session."""
            self.session_id = d["session_id"]
            self.set_icon(STATE_ICON[d["state"]], f"Claude Code [{d['label']}]: {d['state']}")
            self.clear_menu()
            item = icon_item(f"[{d['label']}] {d.get('summary') or ''}", STATE_ICON[d["state"]])
            item.connect("activate", self.app.copy_cwd, d)
            self.menu.append(item)
            item = Gtk.MenuItem(label=d.get("cwd") or "")
            item.set_sensitive(False)
            self.menu.append(item)
            self.menu.show_all()
            self.ind.set_status(AppIndicator.IndicatorStatus.ACTIVE)

    class Indicator:
        def __init__(self):
            self.icon_dir = render_icons()
            self.slots = []
            self.last_states = {}  # session_id -> state, to notify transitions once
            self.refresh_pending = False
            # Create slots last to first, spaced out, so the extension inserts
            # them in order: Claude (0) leftmost, then one per session.
            self.pending_slots = list(range(SLOTS, -1, -1))
            GLib.timeout_add(40, self.create_next_slot)

        def create_next_slot(self):
            if not self.pending_slots:
                self.slots.sort(key=lambda sl: sl.index)
                self.monitor = Gio.File.new_for_path(STATE_DIR).monitor_directory(
                    Gio.FileMonitorFlags.NONE, None)
                self.monitor.connect("changed", self.on_dir_changed)
                GLib.timeout_add_seconds(POLL_SECONDS, self.on_poll)
                self.refresh()
                return False
            self.slots.append(Slot(self.pending_slots.pop(0), self))
            return True

        # Coalesce bursts of file changes into a single refresh
        def on_dir_changed(self, *_):
            if not self.refresh_pending:
                self.refresh_pending = True
                GLib.timeout_add(150, self.refresh_debounced)

        def refresh_debounced(self):
            self.refresh_pending = False
            self.refresh()
            return False

        def on_poll(self):
            self.refresh()
            return True

        def refresh(self):
            sessions = disambiguate(remove_dead(list_sessions()))
            self.notify_transitions(sessions)
            self.slots[0].show_claude(sessions)
            for i, slot in enumerate(self.slots[1:]):
                if i < len(sessions):
                    slot.show_session(sessions[i])
                else:
                    slot.hide()

        def notify_transitions(self, sessions):
            current = {}
            for d in sessions:
                sid = d["session_id"]
                current[sid] = d["state"]
                if d["state"] == "waiting" and self.last_states.get(sid) != "waiting":
                    self.notify(d)
            self.last_states = current

        def notify(self, d):
            try:
                subprocess.Popen(
                    [
                        "notify-send",
                        "--app-name=Claude Code",
                        "--icon=" + (os.path.join(self.icon_dir, icon_name("waiting") + ".png")
                                     if self.icon_dir else "dialog-question"),
                        "--urgency=normal",
                        f"[{d['label']}] needs your attention",
                        d.get("summary") or "",
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            except OSError:
                pass

        def copy_cwd(self, _item, d):
            # Copy the cwd to the clipboard: the most useful thing we can do
            # since Wayland does not let us focus the terminal from outside.
            try:
                from gi.repository import Gdk
                clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
                clip.set_text(d.get("cwd") or "", -1)
                clip.store()
            except Exception:  # noqa: BLE001
                pass

    Indicator()
    try:
        Gtk.main()
    finally:
        try:
            if indicator_pid() == os.getpid():
                os.unlink(PID_FILE)
        except OSError:
            pass
    return 0


# --------------------------------------------------------------------------

def main(argv):
    cmd = argv[1] if len(argv) > 1 else "indicator"
    if cmd == "hook":
        cmd_hook()
    elif cmd == "indicator":
        return cmd_indicator()
    elif cmd == "status":
        cmd_status()
    elif cmd == "clean":
        cmd_clean()
    elif cmd == "setup":
        return cmd_setup()
    elif cmd == "unsetup":
        return cmd_unsetup()
    elif cmd in ("-V", "--version", "version"):
        print(f"claude-sessions {__version__}")
    elif cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
    else:
        print(f"Unknown subcommand: {cmd}", file=sys.stderr)
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv) or 0)
