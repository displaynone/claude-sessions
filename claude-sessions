def git_branch(cwd):
    """Current branch read straight from .git/HEAD (no subprocess). '' if none."""
    d = cwd
    for _ in range(40):
        dotgit = os.path.join(d, ".git")
        if os.path.isdir(dotgit):
            head = os.path.join(dotgit, "HEAD")
            break
        if os.path.isfile(dotgit):  # worktree / submodule: "gitdir: <path>"
            try:
                with open(dotgit) as fh:
                    line = fh.read().strip()
            except OSError:
                return ""
            if not line.startswith("gitdir:"):
                return ""
            gitdir = line[7:].strip()
            if not os.path.isabs(gitdir):
                gitdir = os.path.join(d, gitdir)
            head = os.path.join(gitdir, "HEAD")
            break
        parent = os.path.dirname(d)
        if parent == d:
            return ""
        d = parent
    else:
        return ""
    try:
        with open(head) as fh:
            ref = fh.read().strip()
    except OSError:
        return ""
    if ref.startswith("ref: refs/heads/"):
        return ref[len("ref: refs/heads/"):]
    return ref[:7]  # detached HEAD


def derive_name(cwd, session_title):
    """Fallback name: custom title, else cwd basename plus @branch."""
    if session_title:
        return truncate(session_title, NAME_MAX)
    base = os.path.basename(cwd.rstrip("/")) or cwd
    branch = git_branch(cwd)
    if branch and branch not in ("main", "master"):
        name = f"{base}@{branch}"
    else:
        name = base
    if len(name) <= NAME_MAX:
        return name
    # Trim the branch first so the directory name survives
    if branch and branch not in ("main", "master"):
        room = NAME_MAX - len(base) - 1
        if room >= 4:
            return f"{base}@{branch[: room - 1]}…"
    return truncate(name, NAME_MAX)


def find_pid(session_id):
    """(pid, started_at) of the claude process owning this session.

    1) Claude Code's internal registry (~/.claude/sessions/<pid>.json), not
       documented but present in 2.1.x; it also carries the start time.
    2) Walk up the process tree from this hook until a `claude` process is
       found, taking its start time from /proc.
    """
    try:
        for name in os.listdir(CLAUDE_SESSIONS_DIR):
            if not name.endswith(".json") or "." in name[:-5]:
                continue
            data = read_json(os.path.join(CLAUDE_SESSIONS_DIR, name))
            if data and data.get("sessionId") == session_id:
                pid = int(data.get("pid") or 0)
                if pid_alive(pid):
                    started = data.get("startedAt")
                    return pid, (started / 1000.0 if started else process_start(pid))
    except OSError:
        pass
    pid = os.getppid()
    for _ in range(10):
        if pid <= 1:
            break
        try:
            with open(f"/proc/{pid}/comm") as fh:
                comm = fh.read().strip()
            if comm == "claude":
                return pid, process_start(pid)
            with open(f"/proc/{pid}/stat") as fh:
                pid = int(fh.read().split(")")[-1].split()[1])
        except (OSError, ValueError, IndexError):
            break
    return None, None


def process_start(pid):
    """Process start time (epoch seconds) from /proc, or None."""
    try:
        with open(f"/proc/{pid}/stat") as fh:
            start_ticks = int(fh.read().split(")")[-1].split()[19])
        with open("/proc/uptime") as fh:
            uptime = float(fh.read().split()[0])
        hz = os.sysconf("SC_CLK_TCK")
        return time.time() - uptime + start_ticks / hz
    except (OSError, ValueError, IndexError):
        return None


def tool_detail(tool_name, tool_input):
    """Short description of the tool in use."""
    ti = tool_input if isinstance(tool_input, dict) else {}
    if tool_name == "Bash":
        return f"$ {ti.get('description') or ti.get('command') or ''}"
    if tool_name in ("Read", "Edit", "Write", "MultiEdit", "NotebookEdit"):
        path = ti.get("file_path") or ti.get("notebook_path") or ""
        return f"{tool_name} {os.path.basename(path)}".strip()
    if tool_name in ("Grep", "Glob"):
        return f"{tool_name} {ti.get('pattern') or ''}".strip()
    if tool_name in ("WebFetch", "WebSearch"):
        return f"{tool_name} {ti.get('url') or ti.get('query') or ''}".strip()
    if tool_name in ("Agent", "Task"):
        return f"agent: {ti.get('description') or ''}".strip()
    if tool_name == "Skill":
        return f"/{ti.get('skill') or ''}"
    if tool_name == "AskUserQuestion":
        qs = ti.get("questions") or []
        if qs and isinstance(qs[0], dict):
            return qs[0].get("question") or "question"
        return "question"
    if tool_name == "ExitPlanMode":
        return "plan ready for approval"
    if tool_name.startswith("mcp__"):  # mcp__<server>__<tool>
        parts = tool_name.split("__", 2)
        if len(parts) == 3:
            return f"{parts[1]}: {parts[2]}"
    return tool_name or "tool"


def compute_update(event, payload, prev):
    """Return (state, summary), or None when the event changes nothing."""
    tool = payload.get("tool_name") or ""
    tool_input = payload.get("tool_input")

    if event == "SessionStart":
        return "idle", DEFAULT_SUMMARY["idle"]

    if event == "UserPromptSubmit":
        return "running", payload.get("prompt") or DEFAULT_SUMMARY["running"]

    if event == "PreToolUse":
        if tool in WAITING_TOOLS:
            return "waiting", tool_detail(tool, tool_input)
        return "running", tool_detail(tool, tool_input)

    if event in ("PostToolUse", "PostToolUseFailure"):
        return "running", tool_detail(tool, tool_input)

    if event == "PermissionRequest":
        return "waiting", f"permission: {tool_detail(tool, tool_input)}"

    if event == "Notification":
        ntype = payload.get("notification_type") or ""
        if ntype in IGNORED_NOTIFICATIONS:
            return None
        if ntype == "permission_prompt" and prev.get("state") == "waiting":
            return None  # PermissionRequest already set a better summary
        return "waiting", payload.get("message") or payload.get("title") or ntype

    if event == "Elicitation":
        server = payload.get("mcp_server_name") or "MCP"
        return "waiting", f"{server}: {payload.get('message') or 'question'}"

    if event == "Stop":
        # Show how Claude's last message starts, e.g. "Still waiting for job 4583238."
        return "done", message_summary(payload.get("last_assistant_message")) or DEFAULT_SUMMARY["done"]

    if event == "StopFailure":
        err = payload.get("error") or message_summary(payload.get("last_assistant_message")) or "error"
        return "waiting", f"error: {err}"

    return None


def cmd_hook():
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw) if raw.strip() else {}
        if not isinstance(payload, dict):
            return
        session_id = payload.get("session_id")
        event = payload.get("hook_event_name")
        if not session_id or not event:
            return
        os.makedirs(STATE_DIR, exist_ok=True)
        path = os.path.join(STATE_DIR, f"{session_id}.json")

        if event == "SessionEnd":
            try:
                os.unlink(path)
            except OSError:
                pass
            return

        prev = read_json(path) or {}
        update = compute_update(event, payload, prev)
        if update is None:
            return
        state, summary = update

        cwd = payload.get("cwd") or prev.get("cwd") or os.getcwd()
        title = payload.get("session_title") or prev.get("session_title") or ""
        pid = prev.get("pid") if pid_alive(prev.get("pid")) else None
        started_at = prev.get("started_at")
        if pid is None or not started_at:
            found_pid, found_start = find_pid(session_id)
            pid = pid or found_pid
            started_at = started_at or found_start or time.time()

        data = {
            "session_id": session_id,
            "state": state,
            "summary": truncate(summary, SUMMARY_MAX),
            "cwd": cwd,
            "name": derive_name(cwd, title),
            "session_title": title,
            "transcript_path": payload.get("transcript_path") or prev.get("transcript_path") or "",
            "pid": pid,
            "started_at": started_at,
            "event": event,
            "updated_at": time.time(),
        }
        write_json_atomic(path, data)
    except Exception:  # noqa: BLE001 - never disturb the session
        pass


